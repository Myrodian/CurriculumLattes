# Imagem de desenvolvimento: roda a aplicação direto pelo Maven (spring-boot:run),
# permitindo recompilação incremental a cada mudança sincronizada pelo `docker compose watch`.
FROM maven:3.9-eclipse-temurin-21-alpine

WORKDIR /app

# Baixa as dependências primeiro para aproveitar o cache de camadas.
COPY pom.xml ./
RUN mvn -B --no-transfer-progress dependency:go-offline

COPY src ./src

EXPOSE 8080

CMD ["mvn", "-B", "--no-transfer-progress", "spring-boot:run"]
